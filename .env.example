# Salin file ini menjadi .env dan isi dengan nilai asli Anda.
# Jangan pernah meng-commit file .env ke version control.

# Kunci API Google Gemini (dapatkan dari https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Nama model Gemini yang akan digunakan.
# Model yang valid per 2025 (Google AI Studio / API):
#   gemini-2.0-flash          ← direkomendasikan, cepat dan gratis tier
#   gemini-2.0-flash-lite     ← lebih ringan
#   gemini-1.5-flash          ← stabil, tersedia luas
#   gemini-1.5-pro            ← kualitas lebih tinggi, kuota lebih terbatas
# JANGAN gunakan: gemini-pro, gemini-ultra, atau nama dengan suffix -latest
# (model-model tersebut sudah tidak didukung di endpoint AI Studio v1beta)
GEMINI_MODEL=gemini-2.0-flash

# Port server (opsional, default: 3000)
PORT=3000
